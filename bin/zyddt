#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-only
"""zyddt — ask every engine the same question and require the same answer.

    zyddt [--detail N] axis           N = how many reds quote their output (8)
    zyddt engines                     what can run, and what cannot
    zyddt gen [AXIS...]               write every cell from axes/*.toml
    zyddt axis [AXIS...]              generate, run, and publish the denominator
    zyddt observe FILE                what each engine said about one program
    zyddt ask FILE...                 CELL: all engines must answer alike
    zyddt check FILE...               PIN: compare against the recorded .observed
    zyddt check --regen FILE...       record it (deliberate, and a reviewable diff)
    zyddt surfaces                    the two lexers: what did they leave unmarked
    zyddt selftest                    grade the runner itself — needs no engine
    zyddt suite                       the whole layer, one verdict

Exit codes, the same contract every other repository's wrapper already honours:

    0   green
    1   red — a real disagreement, or a golden that no longer holds
    2   no verdict — an engine did not answer, so nothing may be called a pass
"""

from __future__ import annotations

import argparse
import dataclasses
import fnmatch
import os
import re
import subprocess
import sys
import tomllib
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from zyddt import axes as A            # noqa: E402
from zyddt import compare as C         # noqa: E402
from zyddt import engines as E          # noqa: E402
from zyddt import exclude as X         # noqa: E402
from zyddt import observe as O          # noqa: E402
from zyddt import report as R           # noqa: E402
from zyddt import selftest as S        # noqa: E402

GREEN, RED, NOVERDICT = C.GREEN, C.RED, C.NOVERDICT
worse = C.worse


def _observe_all(cfg, engs, file: Path, phase: str, timeout: float,
                 case_id: str | None = None, table=None, without=()):
    """Run every engine, except the ones a rule excuses from this case.

    An excluded engine is never invoked.  That is the point the exclusion table
    exists to make: `<\\ shell \\>` in zyjs used to ANSWER rather than fail — a
    random number from the stub in zymbol.js, until BUG-GOL-014 (2026-09-29) —
    so running it and discarding the result was not the same as not asking.  It
    refuses now, and the rule stands for every engine that might answer: a
    discarded answer is one refactor away from being read.
    """
    out = []
    for e in engs:
        rule = table.excluded(case_id, e.id, without) if (table and case_id) else None
        if rule is not None:
            out.append(O.Observation(e.id, phase, "EXCLUDED", None, -1, "",
                                     excluded=rule))
            continue
        out.append(O.classify(E.run(e, file, phase, timeout), cfg.normalise))
    return out


def _case_id(file: Path) -> str:
    """The stable name a rule in exclusions.toml matches against.

    A generated cell is `axis/cell`; a pin is its path under cases/.  Never the
    filesystem path as given on the command line — a rule that matched
    `generated/environment/shell-pipe.zy` from one directory and
    `../ZyDDT/generated/...` from another would fire depending on where the
    caller stood, which is precisely the "describes the runner, not the corpus"
    failure corpus.toml called out.
    """
    f = file.resolve()
    root = Path(__file__).resolve().parents[1]
    for base in (root / "generated", root / "cases"):
        if f.is_relative_to(base):
            return str(f.relative_to(base).with_suffix(""))
    return str(f.with_suffix("").name)


def _shown(file: Path) -> str:
    """How a file is named in a report: relative to this repository when it is
    inside it, wherever the caller stands. `zyq suite` runs this layer from
    zyquality/, and every pin used to be printed by its absolute path."""
    f = Path(file).resolve()
    root = Path(__file__).resolve().parents[1]
    return str(f.relative_to(root)) if f.is_relative_to(root) else str(file)


def _indent(text: str, pad: str = "      ") -> str:
    return "\n".join(pad + l for l in text.rstrip("\n").splitlines())


# ── engines ──────────────────────────────────────────────────────────────────
def cmd_engines(args, cfg) -> int:
    probe = Path(__file__).resolve().parents[1] / "cases" / "seed" / "hello.zy"
    rc = GREEN
    for e in cfg.engines:
        ok_run = "—"
        if probe.exists():
            r = E.run(e, probe, "run", args.timeout)
            ok_run = R.green("available") if not r.blocked else R.red(r.blocked)
            if r.blocked:
                rc = NOVERDICT
        static = "yes" if e.check_cmd else R.dim("no static phase")
        print(f"  {R.bold(e.id):<14} {ok_run:<24} {static:<18} {R.dim(e.desc)}")
    return rc


# ── surfaces — the two lexers that are not engines ───────────────────────────
def cmd_surfaces(args, cfg) -> int:
    """What the highlighter and the VS Code grammar left unmarked.

    Graded over ZyDDT's OWN cells and pins, not over a corpus this layer does
    not own. That is the point rather than a limitation: the surfaces are asked
    about exactly the programs the engines are asked about, so a form that earns
    a cell earns it on all five surfaces at once.

    A surface that cannot be started is NO VERDICT, never a pass — the same rule
    as an absent engine. A driver that crashes on one file is reported and the
    sweep continues, because "this file breaks the driver" is itself a finding
    and stopping would hide the rest.

    One thing is excused, and it is MEASURED rather than declared: a token on
    the line a static refusal points at. A cell like `x = #,. 2|v|` exists to be
    refused; there is no operator there for a surface to mark, and a surface
    that marked it `invalid` would be blind for good — every unknown token would
    become "invalid" and none would ever be reported again. So the tree-walker's
    analyser is asked (`zymbol check`), and only the lines its errors name are
    excused. The rest of a refused program is still graded, and so is every
    line of a program that runs — including one that fails at run time, which
    is a valid program (`#.v|x|` with a bad `v`). Decided by the author on
    2026-09-29; before it, 45 such tokens kept `surfaces` RED with every
    valid-program cell clean.
    """
    if not cfg.surfaces:
        print(R.dim("    none declared"))
        return GREEN

    root = Path(__file__).resolve().parents[1]
    files = sorted(set(root.glob("generated/**/*.zy")) | set(root.glob("cases/**/*.zy")))
    rc = GREEN
    refused = _static_refusal_lines(cfg, files, args.timeout)
    if refused is None:
        print(R.dim("    no engine answers the static phase; nothing is excused"))
        refused = {}

    for surf in cfg.surfaces:
        findings: list[tuple[str, str, str, str]] = []
        on_refusal = 0
        try:
            proc = subprocess.run(surf.argv(files), capture_output=True, text=True,
                                  timeout=max(args.timeout, 120))
        except (OSError, subprocess.TimeoutExpired) as exc:
            print(f"  {R.bold(surf.id):<12} {R.red('cannot run')}  {exc}")
            rc = worse(rc, NOVERDICT)
            continue
        if proc.returncode != 0:
            last = (proc.stderr or "").strip().splitlines()
            print(f"  {R.bold(surf.id):<12} {R.red('driver failed')}  "
                  f"{R.dim(last[-1] if last else 'exit ' + str(proc.returncode))}")
            rc = worse(rc, NOVERDICT)
            continue
        for line in proc.stdout.splitlines():
            parts = line.split("\t")
            if len(parts) != 4:
                continue
            path, ln, col, text = parts
            if surf.excused(text):
                continue
            if ln.isdigit() and int(ln) in refused.get(Path(path).resolve(), ()):
                on_refusal += 1
                continue
            rel = Path(path)
            findings.append((str(rel.relative_to(root) if rel.is_relative_to(root) else rel),
                             ln, col, text))

        n = len(findings)
        head = R.green("nothing unmarked") if n == 0 else R.red(f"{n} unmarked")
        print(f"  {R.bold(surf.id):<12} {head:<28} {R.dim(surf.desc)}")
        if surf.tolerate:
            print(f"  {'':<12} {R.dim('tolerates ' + surf.tolerate + ' — ' + surf.reason)}")
        if on_refusal:
            print(f"  {'':<12} {R.dim(f'{on_refusal} more on a line a static refusal points at — excused')}")
        for rel, ln, col, text in findings[: args.detail or 8]:
            print(f"      {R.dim(rel)}:{ln}:{col}  {R.bold(repr(text))}")
        if n > (args.detail or 8):
            print(R.dim(f"      … and {n - (args.detail or 8)} more"))
        if n:
            rc = worse(rc, RED)
    return rc


def _static_refusal_lines(cfg, files, timeout) -> dict[Path, set[int]] | None:
    """For each file the analyser refuses, the lines its errors point at.

    One engine is enough: the static phase is shared — `zytw` and `zyvm` run the
    same analyser, and `zyjs` has none of its own to ask. None when no engine
    answers `check`, so the caller can say so instead of excusing nothing
    silently or everything by accident.
    """
    engs = [e for e in cfg.engines if e.argv("static", Path("x.zy")) is not None]
    if not engs:
        return None
    eng = engs[0]
    out: dict[Path, set[int]] = {}
    for f in files:
        obs = O.classify(E.run(eng, f, "static", timeout), cfg.normalise)
        if obs.status != "error" or obs.kind != "static":
            continue
        lines = {d.line for d in obs.diags if d.severity == "error" and d.line is not None}
        if lines:
            out[Path(f).resolve()] = lines
    return out


# ── observe ──────────────────────────────────────────────────────────────────
def cmd_observe(args, cfg) -> int:
    engs = cfg.by_id(args.engines)
    for file in args.files:
        print(R.bold(str(file)))
        for obs in _observe_all(cfg, engs, file, args.phase, args.timeout):
            print(f"  {obs.engine:<8} {R.verdict(obs.verdict)}")
            print(_indent(O.render(obs), "      " + R.dim("│ ")))
    return GREEN


def _print_consensus(label: str, con, pad: str = "    ") -> None:
    """One printer, so `ask` and `axis` cannot drift into two vocabularies."""
    if con.outcome == C.DIVERGE:
        print(f"{R.red('DIVERGE')}     {label}")
        for members in con.shape_groups:
            who = ",".join(m.engine for m in members)
            print(f"{pad}{R.bold(who):<20} {R.verdict(members[0].verdict)}")
            print(_indent(O.render(members[0]), pad + "    " + R.dim("| ")))
    elif con.outcome == C.WORDING:
        print(f"{R.yellow('WORDING')}     {label}  {R.verdict(con.verdict)}  "
              f"{R.dim('same behaviour, different words')}")
        for members in con.wording_groups:
            who = ",".join(m.engine for m in members)
            for d in members[0].diags:
                print(f"{pad}{R.bold(who):<20} {'; '.join(d.render()).strip()}")
    elif con.outcome == C.PARTIAL:
        print(f"{R.yellow('PARTIAL')}     {label}  {R.verdict(con.verdict)}")
    elif con.outcome == C.NO_VERDICT:
        print(f"{R.bold(R.red('NO VERDICT'))}  {label}")
        for o in con.answered:
            print(f"{pad}{o.engine:<8} {R.verdict(o.verdict)}  {R.dim('answered alone')}")
    for o in con.blocked:
        print(f"{pad}{o.engine:<8} {R.red('BLOCKED')}  {o.blocked}")
    for o in con.excluded:
        print(f"{pad}{o.engine:<8} {R.dim('excluded')}  "
              f"{R.dim(o.excluded.tag + ': ' + o.excluded.reason)}")


# ── ask — the CELL primitive ─────────────────────────────────────────────────
def cmd_ask(args, cfg) -> int:
    """No expectation is written down.  Every engine is asked the same question
    and the answers must be identical.

    CHARTER § 8.2: a cell encodes no belief about the right answer, so it cannot
    encode a wrong one.  This is the form to prefer wherever it can decide.
    """
    engs = cfg.by_id(args.engines)
    table = X.load()
    worst = GREEN
    for file in args.files:
        obs = _observe_all(cfg, engs, file, args.phase, args.timeout,
                           _case_id(file), table, tuple(args.without))
        con = C.consensus(obs, cfg.normalise.compare_column)
        if con.outcome == C.AGREE:
            cov = "" if con.full else R.dim(f"  [{con.coverage}]")
            print(f"{R.green('AGREE')}       {_shown(file)}  {R.verdict(con.verdict)}{cov}")
            for o in con.excluded:
                print(f"    {o.engine:<8} {R.dim('excluded')}  "
                      f"{R.dim(o.excluded.tag + ': ' + o.excluded.reason)}")
            continue
        _print_consensus(_shown(file), con)
        worst = worse(worst, RED if con.outcome == C.DIVERGE else NOVERDICT)
    return worst


# ── check — the PIN primitive ────────────────────────────────────────────────
def cmd_check(args, cfg) -> int:
    """Where a differential cannot decide, a recorded observation does.

    The golden is per engine, because the engines legitimately differ in what
    they *can* say (zyjs carries no column) and a pin's job is to hold one
    engine's behaviour still.  `--regen` records; reading the diff is the review.
    """
    engs = cfg.by_id(args.engines)
    worst = GREEN
    for file in args.files:
        for obs in _observe_all(cfg, engs, file, args.phase, args.timeout):
            gold = file.with_suffix(f".{obs.engine}.observed")
            actual = O.render(obs)

            if args.regen:
                if obs.status == "BLOCKED":
                    print(f"{R.red('SKIP')}        {gold.name}  {obs.blocked}")
                    worst = worse(worst, NOVERDICT)
                    continue
                changed = not gold.exists() or gold.read_text() != actual
                gold.write_text(actual)
                print(f"{R.yellow('RECORDED') if changed else R.dim('unchanged')}    {gold.name}")
                continue

            if obs.status == "BLOCKED":
                print(f"{R.red('BLOCKED')}     {gold.name}  {obs.blocked}")
                worst = worse(worst, NOVERDICT)
                continue
            if not gold.exists():
                print(f"{R.red('NO GOLDEN')}   {gold.name}  {R.dim('run with --regen')}")
                worst = worse(worst, NOVERDICT)
                continue
            expected = gold.read_text()
            if expected == actual:
                print(f"{R.green('HOLDS')}       {gold.name}  {R.verdict(obs.verdict)}")
            else:
                print(f"{R.red('BROKE')}       {gold.name}")
                import difflib
                for l in difflib.unified_diff(
                    expected.splitlines(), actual.splitlines(),
                    "recorded", "now", lineterm="", n=1
                ):
                    print("      " + (R.red(l) if l.startswith("-") else
                                       R.green(l) if l.startswith("+") else R.dim(l)))
                worst = worse(worst, RED)
    return worst


# ── gen / axis — the CELL machinery ──────────────────────────────────────────
def cmd_gen(args, cfg) -> int:
    axes = A.load_all(args.axes or None)
    if not axes:
        print("zyddt: no axes declared in axes/", file=sys.stderr)
        return NOVERDICT
    cells = A.generate(axes, cfg.oracles)
    for ax in axes:
        print(f"  {R.bold(ax.id):<20} {len(ax.cells):>3} cells  {R.dim(ax.what)}")
    print(R.dim(f"  → {len(cells)} files under generated/"))
    return GREEN


def cmd_axis(args, cfg) -> int:
    """Run every cell of every axis and publish the denominator.

    CHARTER § 6: the number that was missing was never the number of bugs — it
    was how many places two engines COULD disagree.  A row here is that number,
    per axis.  An axis nobody has declared has no row, and that absence is worth
    more than a green tick on a suite that never asked.
    """
    axes = A.load_all(args.axes or None)
    if not axes:
        print("zyddt: no axes declared in axes/", file=sys.stderr)
        return NOVERDICT
    A.generate(axes, cfg.oracles)

    table = X.load()
    baseline = _load_baseline()
    wording_now: set[str] = set()
    worst = GREEN
    rows = []

    # A declared debt has to name a finding that is filed, and engines that
    # exist. One that does not is an exclusion with no reason — it would turn a
    # red into KNOWN on the word of nobody — so it is red itself and covers
    # nothing.
    filed, _ = _filed_findings(Path(__file__).resolve().parents[1])
    engine_ids = {e.id for e in cfg.engines}
    void_debt: set[str] = set()
    for ax in axes:
        for cell in ax.cells:
            d = cell.open_finding
            if d is None:
                continue
            ids = [d] if isinstance(d, str) else list(d.values())
            unknown = [e for e in ([] if isinstance(d, str) else d) if e not in engine_ids]
            unfiled = [i for i in ids if i not in filed]
            if unknown or unfiled:
                void_debt.add(f"{ax.id}/{cell.id}")
                worst = worse(worst, RED)
                why = (f"unknown engine(s) {unknown}" if unknown else "") + \
                      ("; " if unknown and unfiled else "") + \
                      (f"{', '.join(unfiled)} is not filed in HALLAZGOS/" if unfiled else "")
                print(f"{R.red('VOID DEBT')}   {ax.id}/{cell.id}  {R.dim(why)}")

    for ax in axes:
        engs = cfg.by_id(ax.engines or None)
        agreed = diverged = worded = wrong = noverdict = narrowed = oracled = 0
        known = 0

        # ── How much of a red gets printed ──────────────────────────────────
        # A matrix changes what a report has to survive.  One defect in `zyjs`
        # writes its warning to stdout, and the operator axis prints that same
        # finding seventy times, in full, with every engine's output quoted:
        # 2049 lines for one axis, in which the four *other* findings are
        # invisible.  A report nobody reads is a report that does not exist.
        #
        # So the first `--detail N` reds of an axis are quoted in full and the
        # rest are one line each, with a closing count of what was shortened.
        # The COUNTS are untouched — every cell still ran, still voted, and
        # still appears in the row at the foot.  This shortens the rendering and
        # says so; it never shortens the denominator, which is the one number
        # this layer exists to publish (CHARTER § 6).
        budget, shortened = [args.detail], [0]

        def detailed() -> bool:
            """→ may this red print its observations? Consumes the budget."""
            if args.verbose or budget[0] > 0:
                budget[0] -= 1
                return True
            shortened[0] += 1
            return False

        for cell in ax.cells:
            label = f"{ax.id}/{cell.id}"
            debt = None if label in void_debt else cell.open_finding

            def owe(verdict_d, paid) -> bool:
                """Print what the declared debt made of a red. → True when the red
                is the debt (KNOWN), so the caller does not count it red."""
                nonlocal known, worst
                if verdict_d == C.KNOWN:
                    known += 1
                    print(f"{R.yellow('KNOWN')}       {label}  "
                          f"{R.dim(_debt_text(debt) + (' — ' + cell.what if cell.what else ''))}")
                    print(R.dim(f"    declared debt: {_debt_where(debt, filed)} — "
                                f"reported every run, not counted against the gate"))
                    return True
                if verdict_d == C.PAID:
                    worst = worse(worst, RED)
                    who = f" for {', '.join(paid)}" if paid else ""
                    print(f"{R.red('DEBT PAID')}   {label}  {R.dim(_debt_text(debt))}")
                    print(R.dim(f"    passes{who}: the finding looks fixed — close it in "
                                f"{_debt_where(debt, filed)} and drop `open_finding`"))
                return False

            if cell.skip:
                # A skipped cell names the axis value it skips and why, so a
                # hole in a matrix is visible AS a hole (CHARTER § 5).
                print(f"{R.yellow('SKIP')}        {label}  {cell.skip}")
                noverdict += 1
                worst = worse(worst, NOVERDICT)
                continue

            dropped = table.dropped_class(label, tuple(args.without))
            if dropped is not None:
                print(f"{R.dim('DROPPED')}     {label}  "
                      f"{R.dim(dropped.tag + ' — asked for with --without')}")
                noverdict += 1
                continue
            obs = _observe_all(cfg, engs, cell.path, args.phase, args.timeout,
                               label, table, tuple(args.without))
            con = C.consensus(obs, cfg.normalise.compare_column)

            # ── Compliance: does each engine reach the required category? ──
            # Before the branches, not after, and per ENGINE rather than per
            # consensus.  A DIVERGE used to stop here and report only that the
            # engines differ — which is a fact about a pair and routes nowhere.
            # Naming the engine that is out of compliance is what turns an
            # observation into a finding somebody can file.
            required = cell.expect or ax.expect
            bad = C.offenders(obs, required) if required else []
            if bad:
                if owe(*C.debt(debt, True, frozenset(o.engine for o in bad))):
                    continue
                wrong += 1
                worst = worse(worst, RED)
                print(f"{R.red('WRONG')}       {label}  {R.dim(cell.what)}")
                if not detailed():
                    print(R.dim(f"    → HALLAZGOS/"
                                f"{bad[0].engine if len(bad) == 1 else 'GLOBAL'}.md"))
                    continue
                for o in obs:
                    if o.status in ("BLOCKED", "EXCLUDED"):
                        continue
                    ok = o.status == required
                    mark = R.green("cumple") if ok else R.red("INCUMPLE")
                    print(f"    {R.bold(o.engine):<18} {R.verdict(o.verdict):<22} "
                          f"{mark} {R.dim('expect=' + required)}")
                    if not ok:
                        print(_indent(O.render(o), "        " + R.dim("| ")))
                who = ",".join(o.engine for o in bad)
                print(R.dim(f"    → HALLAZGOS/"
                            f"{who if len(bad) == 1 else 'GLOBAL'}.md"))
                continue

            if con.outcome == C.DIVERGE:
                if owe(*C.debt(debt, True, frozenset())):
                    continue
                diverged += 1
                worst = worse(worst, RED)
                if not detailed():
                    print(f"{R.red('DIVERGE')}     {label}  {R.dim(cell.what)}")
                    continue
                _print_consensus(f"{label}  {R.dim(cell.what)}", con)
                # A divergence where every engine still meets the required
                # category: they disagree about HOW, not about WHAT. Worth
                # saying, because it routes to the global file, not to one
                # engine's.
                if required:
                    print(R.dim(f"    every engine reaches expect={required}; "
                                f"they differ in how → HALLAZGOS/GLOBAL.md"))
                continue
            if con.outcome == C.NO_VERDICT:
                noverdict += 1
                worst = worse(worst, NOVERDICT)
                _print_consensus(label, con)
                continue

            v = con.answered[0]

            # ── The oracle: is the answer they agree on also RIGHT? ─────
            # Placed BEFORE the wording and partial branches, not after.  It sat
            # after them at first, so a cell whose engines split only on the
            # WORDING of a diagnostic never had its answer checked at all — the
            # gate would carry a known, baselined wording split and silently stop
            # verifying the output underneath it.  Every outcome that reaches
            # here shares one `shape_key`, and stdout is part of that key, so
            # `v.out` is every answering engine's output.
            #
            # It is not reachable from DIVERGE or NO_VERDICT, and deliberately:
            # an oracle run against engines that disagree answers a question
            # nobody asked ("which of them is right") when the finding is that
            # they differ at all.
            if cell.oracle and C.oracle_applies(con.outcome):
                oid, _ = cell.oracle
                orc = cfg.oracles[oid]
                raw = E.run_oracle(orc, cell.oracle_path(orc.ext), args.timeout)
                if raw.blocked:
                    print(f"{R.yellow('NO ORACLE')}   {label}  {raw.blocked}")
                    noverdict += 1
                    worst = worse(worst, NOVERDICT)
                    continue
                sus = A.suggestive(cell, raw.stdout)
                if sus is not None:
                    # Not a failure of the engines. A failure of the CELL: the
                    # oracle is confirming a number that was typed into the very
                    # program it is supposed to be checking.
                    worst = worse(worst, NOVERDICT)
                    noverdict += 1
                    print(f"{R.yellow('SUGGESTIVE')}  {label}  "
                          f"{R.dim('the oracle answer ' + repr(sus) + ' appears in the .zy source')}")
                    print(R.dim("    an oracle checks nothing unless both sides compute;"
                                ' silence with oracle_literal_ok = "reason"'))
                    continue
                if raw.stdout != v.out:
                    if owe(*C.debt(debt, True, frozenset())):
                        continue
                    wrong += 1
                    worst = worse(worst, RED)
                    print(f"{R.red('WRONG ANSWER')} {label}  "
                          f"{R.dim('all engines agree, and the oracle disagrees')}")
                    print(f"    {R.bold('engines'):<20} {v.out.strip()!r}")
                    print(f"    {R.bold(orc.id + ' oracle'):<20} {raw.stdout.strip()!r}")
                    print(R.dim(f"    {orc.desc}"))
                    continue
                oracled += 1

            if not con.full:
                narrowed += 1

            if con.outcome == C.WORDING:
                worded += 1
                wording_now.add(label)
                if label not in baseline:
                    if owe(*C.debt(debt, True, frozenset())):
                        continue
                    worst = worse(worst, RED)      # a NEW wording split is a red
                    print(f"{R.red('NEW WORDING')} {label}  "
                          f"{R.dim('not in wording.baseline')}")
                    if detailed():
                        _print_consensus(label, con)
                else:
                    owe(*C.debt(debt, False, frozenset()))   # baselined: green
                    if args.verbose:
                        _print_consensus(label, con)
                continue

            if con.outcome == C.PARTIAL:
                noverdict += 1
                worst = worse(worst, NOVERDICT)
                _print_consensus(label, con)
                continue

            agreed += 1
            owe(*C.debt(debt, False, frozenset()))           # green: a debt is paid
            if args.verbose or not con.full:
                cov = "" if con.full else R.dim(f"  [{con.coverage}]")
                print(f"{R.green('AGREE')}       {label}  {R.verdict(v.verdict)}{cov}")
                for o in con.excluded:
                    print(f"    {o.engine:<8} {R.dim('excluded')}  "
                          f"{R.dim(o.excluded.tag + ': ' + o.excluded.reason)}")

        if shortened[0]:
            print(R.dim(f"  {shortened[0]} more red cell(s) in '{ax.id}' printed "
                        f"without their output — `zyddt --detail 0 axis` for "
                        f"none, `zyddt -v axis` for all, `zyddt observe FILE` "
                        f"for one"))
        rows.append((ax.id, len(ax.cells), agreed, worded, diverged, wrong,
                     noverdict, narrowed, oracled, known))

    # Only over the axes that actually ran.  `zyddt axis environment` compared
    # the whole baseline against one axis's results and announced that three
    # splits had closed; they had simply not been asked.  A partial run may not
    # report a global improvement.
    #
    # A stale entry is RED (GLB-040, decided 2026-09-25).  While it stays in the
    # list, the cell it names may split again and the gate will accept it in
    # silence — an open door, which is what `--audit-exclusions` refuses in
    # zyquality.  It is removed by hand, in the step that healed it.  There is
    # no command that rewrites the file: `--regen-baseline` absorbed splits
    # nobody had decided and twice ate the comments that explained the ones
    # somebody had (HOW_TO_CHANGE_ZYMBOL.md § 2, move 5).
    ran = {ax.id for ax in axes}
    healed = {e for e in baseline - wording_now if e.split("/", 1)[0] in ran}
    if healed:
        worst = worse(worst, RED)
        print()
        for e in sorted(healed):
            print(f"{R.red('STALE WORDING')} {e}  "
                  f"{R.dim('agrees now, or no longer exists — remove it from wording.baseline by hand')}")

    print()
    print(f"  {'axis':<22}{'cells':>6}{'agree':>7}{'oracled':>9}{'narrowed':>10}"
          f"{'wording':>9}{'diverge':>9}{'wrong':>7}{'known':>7}{'no verdict':>12}")
    for name, cells, ag, wd, dv, wr, nv, nr, orc, kn in rows:
        print(f"  {name:<22}{cells:>6}{ag:>7}"
              f"{(R.green(str(orc)) if orc else R.dim('0')):>9}"
              f"{(R.dim(str(nr)) if nr else '0'):>10}"
              f"{(R.yellow(str(wd)) if wd else '0'):>9}"
              f"{(R.red(str(dv)) if dv else '0'):>9}"
              f"{(R.red(str(wr)) if wr else '0'):>7}"
              f"{(R.yellow(str(kn)) if kn else '0'):>7}"
              f"{(R.yellow(str(nv)) if nv else '0'):>12}")
    print(R.dim("  oracled  = agreed AND checked against an implementation that is not ours"))
    print(R.dim("  narrowed = agreed, but a rule excused an engine: fewer surfaces asked"))
    print(R.dim("  known    = red, and the declared debt of a filed finding (open_finding)"))
    print(R.dim("  an axis that is not declared has no row, and that is the honest gap"))

    dead = table.dead_rules()
    if dead:
        # `zyq audit` is right to call these dead: a rule matching no case is
        # either a case deleted without its exclusion, or an exclusion written
        # for a case that never existed. Both are how a list stops describing
        # anything. Only meaningful over a FULL run, so it is silent when the
        # caller narrowed the axes.
        if not args.axes:
            print()
            for r in dead:
                print(f"  {R.yellow('DEAD RULE')}  {r.match:<28} {R.dim(r.tag)}  "
                      f"{R.dim('matched no case')}")
            worst = worse(worst, NOVERDICT)
    return worst


def _debt_text(debt) -> str:
    if isinstance(debt, str):
        return debt
    return ", ".join(f"{e} {i}" for e, i in sorted(debt.items()))


def _debt_where(debt, filed: dict[str, str]) -> str:
    ids = [debt] if isinstance(debt, str) else sorted(set(debt.values()))
    return ", ".join(f"{filed.get(i, 'HALLAZGOS/')} {i}" for i in ids)


BASELINE = Path(__file__).resolve().parents[1] / "wording.baseline"


def _load_baseline() -> set[str]:
    """Cells where the engines behave alike and word it differently.

    A list rather than a count, because a count that stays at 3 while one split
    closes and another opens is a green gate over a regression.  This is the
    `messages/` rule applied to what is actually emitted at runtime: it may
    fall, and it may not rise.
    """
    if not BASELINE.exists():
        return set()
    return {l.split("#", 1)[0].strip() for l in BASELINE.read_text().splitlines()
            if l.split("#", 1)[0].strip()}


# ── selftest — grading the grader ────────────────────────────────────────────
def cmd_selftest(args, cfg) -> int:
    """Two halves. The cold one needs no engine, on purpose: if it did, a broken
    engine would look like a broken runner and the test would be useless exactly
    when it matters."""
    passed, total, failures = S.run(args.verbose)
    for f in failures:
        print(f"  {R.red('FAIL')}  {f}")
    tick = R.green("ok") if not failures else R.red("FAILED")
    print(f"  cold  {passed}/{total} {tick}  "
          f"{R.dim('classifier, parser, comparator, globs, config')}")

    # The live half. Separate, and named, because it is the one that can fail
    # for a reason that is not the runner's fault.
    probe = Path(__file__).resolve().parents[1] / "cases" / "seed" / "hello.zy"
    live_bad = []
    for e in cfg.engines:
        obs = O.classify(E.run(e, probe, "run", args.timeout), cfg.normalise)
        if obs.status == "BLOCKED":
            live_bad.append(f"{e.id}: {obs.blocked}")
        elif obs.verdict != "ok" or obs.out != "hola\n":
            live_bad.append(f"{e.id}: answered {obs.verdict} {obs.out!r}, "
                            f"expected ok 'hola\\n'")
    # The command surface. Separate from both halves above because it needs the
    # engines AND the runner, and it is the only thing that would have caught a
    # NameError in a command body.
    smoke_bad = S.smoke_cli(Path(__file__).resolve())
    for b in smoke_bad:
        print(f"  {R.red('FAIL')}  cmd/{b}")
    smoke_tick = R.green("ok") if not smoke_bad else R.red("FAILED")
    print(f"  cmd   {len(S.SMOKE) - len(smoke_bad)}/{len(S.SMOKE)} {smoke_tick}  "
          f"{R.dim('every subcommand survives being called')}")

    for b in live_bad:
        print(f"  {R.red('FAIL')}  live/{b}")
    live_tick = R.green("ok") if not live_bad else R.red("FAILED")
    print(f"  live  {len(cfg.engines) - len(live_bad)}/{len(cfg.engines)} {live_tick}  "
          f"{R.dim('every engine runs the seed and answers it right')}")

    if failures or smoke_bad:
        return RED
    return NOVERDICT if live_bad else GREEN


# ── suite — one command, one verdict ─────────────────────────────────────────

# ── The premises ─────────────────────────────────────────────────────────────
#
# Every other command here compares an implementation against another
# implementation. None of them can see a rule that all three engines break
# together, and none could see MEM-2 being retired on 2026-08-24 — the engine,
# the guide and the one-page brief moved in one commit and stayed consistent
# with each other.
#
# This one crosses the axes against `zymbol-design/PREMISES.md`, which is a
# SOURCE: it is not derived from any engine, and it lives in its own repository
# so that it is not even in the working tree while somebody is fixing one.
#
# The crossing is deliberately BIDIRECTIONAL. One direction alone is the failure
# it exists to prevent:
#
#   · premise → cell only, and a cell may claim a premise nobody declared;
#   · cell → premise only, and a premise may quietly lose the cell that held it
#     while its `Held by` still names it.

DESIGN_DIR = "ZYMBOL_DESIGN"          # env override, like every path in engines.toml
# `##` or `###`: the ids sit under a domain heading, and the depth of that
# heading is the document's business rather than this parser's.
PREMISE_HEAD = re.compile(r"^#{2,4}\s+([A-Z]{2,6}-\d+)\s+—\s+(.+?)\s*$", re.M)
CELL_REF = re.compile(r"`([a-z0-9_-]+/[a-z0-9_*-]+)`")


def _design_dir() -> Path:
    env = os.environ.get(DESIGN_DIR)
    if env:
        return Path(env).expanduser()
    return Path(__file__).resolve().parents[2] / "zymbol-design"


def _premises_of(text: str) -> dict[str, dict]:
    """→ {id: {what, held: [glob], stated_empty: bool}} from PREMISES.md.

    The section of an id runs to the next `## ` heading, so a `Held by` is read
    from its own premise and never from the next one.
    """
    out, heads = {}, list(PREMISE_HEAD.finditer(text))
    stops = [m.start() for m in re.finditer(r"^#{1,4}\s", text, re.M)]
    for m in heads:
        nxt = next((s_ for s_ in stops if s_ > m.end()), len(text))
        body = text[m.end():nxt]
        held_line = ""
        for line in body.splitlines():
            if line.startswith("**Held by**"):
                held_line = line
            elif held_line and line.startswith(("`", "(", "not ", "**red**")):
                held_line += " " + line      # a `Held by` wrapped for width
            elif held_line:
                break
        out[m.group(1)] = {
            "what": m.group(2),
            "held": CELL_REF.findall(held_line),
            "stated_empty": "nothing yet" in held_line,
            # A third state, and it is not a weaker version of the other two.
            # MEM and COL constrain what a PROGRAM may do, so a program can be
            # written that breaks them. Most of SYM constrains what a PROPOSAL
            # may be — "derive, do not invent" is checked by a reader against an
            # inventory, and no execution can ask it. Reporting those as holes
            # would file a property of the domain as debt.
            "by_review": held_line.strip().startswith("**Held by** — review"),
            # A fourth state. Some claims are not about what a program prints:
            # a ratio of peak memory, or the shape of an archive. Those are held
            # by a suite outside this layer, and reporting them as missing cells
            # would file a working guarantee as debt. Marked by starting the
            # line with "elsewhere:" so it cannot be confused with prose.
            "elsewhere": held_line.strip().startswith("**Held by** — elsewhere:"),
        }
    return out


def _declared_premises() -> dict[str, set[str]]:
    """→ {cell_id_with_axis: {premise_id}} read from the axis TOMLs themselves.

    A set, not one id: a cell measures a situation, and one situation can be
    evidence for more than one rule. `block-var-direct` shows both that a block
    does not leak into its container (MEM-6) and that a function does not reach
    a block (MEM-2), and making it choose would mean writing the same program
    twice under two names — the redundancy the admission rule forbids.

    Read raw rather than through `axes.load_all`, because `premise` is a
    property of the DECLARATION: a matrix declares it once for every point it
    generates, and a `[[cell]]` declares its own.
    """
    out = {}
    for path in sorted(A.AXES_DIR.glob("*.toml")):
        d = tomllib.loads(path.read_text(encoding="utf-8"))
        named = {c["id"]: c.get("premise") for c in d.get("cell", [])}
        # An axis may declare one for all of its cells, the way it declares
        # `expect`: a matrix's points and the loose `[[cell]]`s beside it are
        # asking about the same rule, and annotating each by hand is how one
        # gets forgotten.
        axis_premise = d.get("premise")
        matrix_premise = d.get("matrix", {}).get("premise", axis_premise)
        for cell in A.load_all_from(A.AXES_DIR, [path.stem])[0].cells:
            if cell.id in named:               # a loose [[cell]]
                p = named[cell.id] or axis_premise
            else:                              # generated by the matrix
                p = matrix_premise or axis_premise
            if p:
                out[f"{path.stem}/{cell.id}"] = {p} if isinstance(p, str) else set(p)
    return out


def cmd_premises(args, cfg) -> int:
    """Cross the declared premises against the cells that claim to hold them."""
    design = _design_dir()
    doc = design / "PREMISES.md"
    if not doc.is_file():
        print(R.yellow(f"  SKIPPED — {doc} not found"))
        print(R.dim(f"    clone zymbol-design beside this repository, or set "
                    f"{DESIGN_DIR}=<path>"))
        print(R.dim("    exit 2: the check did not run, which is not the same "
                    "as nothing being wrong"))
        return NOVERDICT

    premises = _premises_of(doc.read_text(encoding="utf-8"))
    declared = _declared_premises()
    known = {f"{ax.id}/{c.id}" for ax in A.load_all() for c in ax.cells}
    rc, holes, reviewed, elsewhere = GREEN, 0, 0, 0

    # cell → premise: a cell may not claim an id the source does not declare.
    for cell, pids in sorted(declared.items()):
        for pid in sorted(pids):
            if pid not in premises:
                print(R.red(f"  UNDECLARED  {cell} claims {pid}, "
                            f"which {doc.name} does not declare"))
                rc = RED

    for pid in sorted(premises):
        p = premises[pid]
        if p["by_review"]:
            print(f"  {R.dim(pid)}  {R.dim('by review')}  " + R.dim(p["what"]))
            reviewed += 1
            continue
        if p["elsewhere"]:
            print(f"  {R.dim(pid)}  {R.dim('held elsewhere')}  " + R.dim(p["what"]))
            elsewhere += 1
            continue
        if p["stated_empty"]:
            print(R.yellow(f"  {pid}  no cell — ") + R.dim(p["what"]))
            holes += 1
            continue
        if not p["held"]:
            print(R.red(f"  {pid}  states no `Held by` at all — a premise whose "
                        f"cells nobody wrote down is a premise nobody is keeping"))
            rc = RED
            continue
        broken = False                     # this premise's own crossing
        for glob in p["held"]:
            hit = fnmatch.filter(known, glob)
            if not hit:
                # The dead reference: the premise still names a cell that is gone,
                # which reads as covered and is not.
                print(R.red(f"  DEAD REF    {pid} names `{glob}`, "
                            f"which matches no cell"))
                broken = True
                continue
            # premise → cell: every cell it names must name it back.
            for cell in hit:
                if pid not in declared.get(cell, set()):
                    got = ", ".join(sorted(declared.get(cell, set()))) or "nothing"
                    print(R.red(f"  ONE-SIDED   {pid} names `{cell}`, "
                                f"which declares {got}"))
                    broken = True
        # Its line is green only when its own crossing held. It used to be
        # printed green unconditionally (`if rc == GREEN or True`), so a premise
        # was listed as kept on the line right under the error that said it was
        # not.
        n = sum(len(fnmatch.filter(known, g)) for g in p["held"])
        if broken:
            rc = RED
            print(f"  {R.red(pid)}  {n} cell(s)  " + R.dim(p["what"]))
        else:
            print(f"  {R.green(pid)}  {n} cell(s)  " + R.dim(p["what"]))

    print()
    print(f"  {len(premises)} premise(s) declared in {doc.name}, "
          f"{holes} with no cell yet"
          + (f", {reviewed} checked by review rather than by execution"
             if reviewed else "")
          + (f", {elsewhere} held by a suite outside this layer"
             if elsewhere else ""))
    if holes:
        print(R.dim("    a premise with no cell is a hole that names itself; "
                    "it is not a pass and not a failure"))
    return rc


# ── pins — every pin names a finding that is filed ───────────────────────────
#
# CHARTER § 3: a pin is "one minimal reproduction of a named finding, carrying
# the ID it came from", and "a pin with no ID is a file nobody can explain".
# Nothing checked it. Two pins carried an id of a series nobody had declared
# (`ZYQ-`): one of them said GLB-005 in its own first line and ZYQ-001 in its
# name, and the other named a finding that had never been filed anywhere.
#
# Three rules, each one a way a pin stops explaining itself:
#   · its name starts with the id                      → UNNAMED
#   · its first line is `// PIN <that id>`             → MISNAMED
#   · the id is a heading in HALLAZGOS/, or in
#     Divergente_ES/ for the DM series                 → UNFILED
#
# Two pins may share an id: ZYVM-001 has two faces that cannot share a file,
# because a refusal stops the run before the second is asked. That is reported,
# not refused — the header of each says why it is separate.

PIN_NAME = re.compile(r"^([A-Z]{2,6}-\d+)_")
PIN_HEAD = re.compile(r"^//\s*PIN\s+([A-Z]{2,6}-\d+)\b")
FINDING_HEAD = re.compile(r"^#{1,4}\s+(?:~~)?([A-Z]{2,6}-\d+)(?:~~)?\b", re.M)


def _filed_findings(root: Path) -> tuple[dict[str, str], bool]:
    """→ ({id: where it is filed}, whether Divergente_ES could be read)."""
    out: dict[str, str] = {}
    for f in sorted((root / "HALLAZGOS").glob("*.md")):
        if f.name == "INDICE.md":
            continue
        for m in FINDING_HEAD.finditer(f.read_text(encoding="utf-8")):
            out.setdefault(m.group(1), f"HALLAZGOS/{f.name}")
    div = Path(os.environ.get("ZYDDT_DIVERGENTE", root.parent / "Divergente_ES"))
    if not div.is_dir():
        return out, False
    for f in sorted(div.glob("*.md")):
        for m in FINDING_HEAD.finditer(f.read_text(encoding="utf-8")):
            out.setdefault(m.group(1), f"Divergente_ES/{f.name}")
    return out, True


def cmd_pins(args, cfg) -> int:
    """Every pin names a filed finding, in its name and in its first line."""
    root = Path(__file__).resolve().parents[1]
    filed, have_div = _filed_findings(root)
    rc, seen = GREEN, {}
    for pin in sorted((root / "cases" / "pin").glob("*.zy")):
        name = PIN_NAME.match(pin.name)
        if not name:
            print(R.red(f"  UNNAMED     {pin.name} — a pin's name starts with the id it pins"))
            rc = worse(rc, RED)
            continue
        pid = name.group(1)
        seen.setdefault(pid, []).append(pin.name)
        first = pin.read_text(encoding="utf-8").splitlines()[:1]
        head = PIN_HEAD.match(first[0]) if first else None
        if not head or head.group(1) != pid:
            said = head.group(1) if head else "no `// PIN <id>` line"
            print(R.red(f"  MISNAMED    {pin.name} — named {pid}, its first line says {said}"))
            rc = worse(rc, RED)
            continue
        if pid in filed:
            continue
        if pid.startswith("DM-") and not have_div:
            print(R.yellow(f"  UNVERIFIED  {pin.name} — {pid} is a Divergente_ES id, and "
                           f"that repository is not cloned beside this one"))
            rc = worse(rc, NOVERDICT)
            continue
        print(R.red(f"  UNFILED     {pin.name} — no finding called {pid} in HALLAZGOS/"
                    + ("" if not pid.startswith("DM-") else " or Divergente_ES/")))
        rc = worse(rc, RED)
    shared = {k: v for k, v in seen.items() if len(v) > 1}
    for pid, names in sorted(shared.items()):
        print(R.dim(f"  shared      {pid}: {', '.join(names)}"))
    n = sum(len(v) for v in seen.values())
    print(f"  {n} pin(s), {len(seen)} finding(s)" +
          ("" if rc != GREEN else R.dim(" — every one named and filed")))
    return rc


def cmd_suite(args, cfg) -> int:
    """What every other repository's wrapper delegates to.

    The order is not cosmetic.  Availability is checked FIRST and its failure is
    terminal, because everything after it would otherwise report "nothing ran"
    as "nothing failed" — the one thing ZyQuality's governance forbids and the
    reason its wrappers exit 2 rather than 0 when the layer is absent.
    """
    # The runner first. Every number below is meaningless if the thing
    # producing it is wrong, and a broken runner reports the ENGINES — which is
    # how ZyQuality's reversed argv and missing module resolver both showed up
    # as divergences rather than as harness defects.
    print(R.bold("  selftest"))
    if cmd_selftest(args, cfg) == RED:
        print(R.red("\n  the runner does not grade correctly; nothing below is evidence"))
        return NOVERDICT

    # The declaration, before anything is run. It needs no engine, and it is the
    # only check here that compares the implementations against something that
    # is not another implementation. NO VERDICT when zymbol-design is absent is
    # deliberate: a layer that cannot see the premises cannot report that they
    # hold.
    print(R.bold("\n  premises") + R.dim("   (zymbol-design/PREMISES.md, the source)"))
    rc = cmd_premises(args, cfg)
    if rc == NOVERDICT:
        print(R.yellow("\n  the premises could not be read; what follows grades "
                       "the engines against each other only"))
    elif rc == RED:
        print(R.red("\n  a premise and its cells disagree about what holds it"))

    print(R.bold("\n  engines"))
    rc_engines = cmd_engines(args, cfg)
    if rc_engines != GREEN:
        print(R.red("\n  an engine did not answer; nothing below may be called a pass"))
        return NOVERDICT
    rc = worse(rc, rc_engines)

    print(R.bold("\n  axes") + R.dim("   (cells, generated from axes/*.toml)"))
    rc = worse(rc, cmd_axis(args, cfg))

    # The two lexers, before the pins: they read the same programs the axes just
    # ran, and a surface that cannot be started is NO VERDICT like an engine.
    print(R.bold("\n  surfaces") + R.dim("   (the two lexers that never run a program)"))
    rc = worse(rc, cmd_surfaces(args, cfg))

    pins = sorted((Path(__file__).resolve().parents[1] / "cases" / "pin").glob("*.zy"))
    print(R.bold("\n  pins") + R.dim(f"   ({len(pins)} named finding{'' if len(pins) == 1 else 's'})"))
    if pins:
        rc = worse(rc, cmd_pins(args, cfg))
        args.files = pins
        rc = worse(rc, cmd_ask(args, cfg))
    else:
        print(R.dim("    none recorded yet"))

    print()
    if rc == GREEN:
        # It used to end "see the undeclared axes above", and nothing above
        # listed any: an undeclared axis has no row, which is the only honest
        # way this report can show it (CHARTER § 6).
        print("  " + R.green(R.bold("GREEN")) + R.dim(
            " — nothing regressed in what has been declared."
            "  It does not mean correct: an axis nobody declared has no row above."))
    elif rc == RED:
        print("  " + R.red(R.bold("RED")) + " — a regression, not noise.")
    else:
        print("  " + R.yellow(R.bold("NO VERDICT")) +
              " — something did not answer, so nothing is a pass.")
    return rc


def main() -> int:
    p = argparse.ArgumentParser(prog="zyddt", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--engines", type=lambda s: s.split(","),
                   help="comma-separated ids (default: all in engines.toml)")
    p.add_argument("--phase", choices=["run", "static"], default="run",
                   help="execute the program, or only analyse it")
    p.add_argument("--timeout", type=float, default=30.0)
    p.add_argument("--without", action="append", default=[], metavar="TAG",
                   help="drop a whole exclusion class for every engine, e.g.\n                        --without STD_DB for a release package with no ODBC")
    p.add_argument("--strict-column", action="store_true",
                   help="compare the diagnostic column too. engines.toml leaves it\n                        off because zyjs cannot produce one at all; this is the\n                        switch for the day it can")
    sub = p.add_subparsers(dest="cmd", required=True)

    p.add_argument("-v", "--verbose", action="store_true",
                   help="print agreeing cells too, not only the failures")
    p.add_argument("--detail", type=int, default=8, metavar="N",
                   help="quote the output of at most N red cells per axis "
                        "(default 8; the counts are never shortened)")
    sub.add_parser("engines", help="what can run, and what cannot")
    sub.add_parser("selftest", help="grade the runner itself — needs no engine")
    sub.add_parser("surfaces", help="the two lexers: what did they leave unmarked")
    sub.add_parser("premises", help="the declared premises, against the cells "
                                    "that hold them")
    sub.add_parser("pins", help="every pin names a filed finding, in its name "
                                "and in its first line")
    sub.add_parser("suite", help="the whole layer, one verdict")
    for name, help_ in (("gen", "write every cell from axes/*.toml"),
                        ("axis", "generate, run, and publish the denominator")):
        sp = sub.add_parser(name, help=help_)
        sp.add_argument("axes", nargs="*", help="axis file stems (default: all)")
    for name, help_ in (("observe", "what each engine said"),
                        ("ask", "CELL: all engines must answer alike"),
                        ("check", "PIN: compare against the recorded .observed")):
        sp = sub.add_parser(name, help=help_)
        sp.add_argument("files", nargs="+", type=Path)
        if name == "check":
            sp.add_argument("--regen", action="store_true",
                            help="record the observation instead of comparing it")

    args = p.parse_args()
    # `suite` reuses the other handlers, so give it the fields they read.
    for attr, default in (("axes", []), ("files", []), ("regen", False)):
        if not hasattr(args, attr):
            setattr(args, attr, default)
    cfg = E.load()
    if args.strict_column:
        cfg = dataclasses.replace(
            cfg, normalise=dataclasses.replace(cfg.normalise, compare_column=True))
    return {"engines": cmd_engines, "observe": cmd_observe, "ask": cmd_ask,
            "check": cmd_check, "gen": cmd_gen, "axis": cmd_axis,
            "suite": cmd_suite, "selftest": cmd_selftest,
            "surfaces": cmd_surfaces, "premises": cmd_premises,
            "pins": cmd_pins}[args.cmd](args, cfg)


if __name__ == "__main__":
    sys.exit(main())
